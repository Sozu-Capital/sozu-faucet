# ── Network (testnet-only in v1) ────────────────────────────────────────────
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org

# ── Payout ──────────────────────────────────────────────────────────────────
# Treasury G secret that signs claims (never expose to the client).
FAUCET_TREASURY_SECRET=S...
# Optional vault contract with claim(to, amount). If unset → SEP-41 transfer.
FAUCET_CONTRACT_ID=
# Circle USDC SAC override (default = Asset("USDC", issuer).contractId(TESTNET))
FAUCET_TOKEN_CONTRACT_ID=
# Alias accepted for the same override
# TESTNET_CIRCLE_USDC_SAC_CONTRACT_ADDRESS=
CIRCLE_TESTNET_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

FAUCET_SLUG=sozu-testnet
FAUCET_NAME=Sozu Faucet
FAUCET_CLAIM_AMOUNT=20
FAUCET_DAILY_LIMIT=5000
# Per-wallet / per-user cooldown (Circle-like ~2h). Set 0 to disable (testing only).
FAUCET_COOLDOWN_MINUTES=120
# Optional global gap between any two successful claims.
FAUCET_GLOBAL_COOLDOWN_MINUTES=0

# ── Auth ───────────────────────────────────────────────────────────────────
# Mode A: HS256 secret for Bearer JWTs minted by Sozu Wallet (or ops scripts)
FAUCET_AUTH_SECRET=change-me-to-a-long-random-string
# Mode B: Cloudflare Turnstile captcha (public paste claims)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Set to 'true' to enforce captcha even in dev (default: only in NODE_ENV=production)
# FAUCET_REQUIRE_CAPTCHA=false
# Soft hash salt for IP / UA (no raw PII stored)
FAUCET_HASH_SALT=sozu-faucet-v1

# Mode C: PoW for terminal / npx @sozu/faucet (no browser)
# ~20 leading zero bits ≈ a few seconds on a laptop CPU
FAUCET_POW_DIFFICULTY=20
FAUCET_POW_TTL_SECONDS=300
FAUCET_POW_CHALLENGE_PER_IP_PER_MIN=10

# ── CORS ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Public URL (for UI API strip) ───────────────────────────────────────────
# NEXT_PUBLIC_FAUCET_PUBLIC_URL=https://faucet.sozu.capital

# Sozu App origin for "Login with Sozu" Redirect Handoff (no trailing slash)
# NEXT_PUBLIC_WALLET_URL=https://app.sozu.capital
# Staging App: NEXT_PUBLIC_WALLET_URL=https://dev.sozu.capital
# Local: NEXT_PUBLIC_WALLET_URL=http://localhost:3000

# ── Database (libsql / Turso) ───────────────────────────────────────────────
# Local default: file:./data/faucet.db
# Production: libsql://your-db.turso.io + TURSO_AUTH_TOKEN
DATABASE_URL=file:./data/faucet.db
# TURSO_AUTH_TOKEN=

# ── Sozutag Resolution (shares Supabase with sozu-wallet) ───────────────────
# Same Supabase instance as sozu-wallet for sozutag → address lookups
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
