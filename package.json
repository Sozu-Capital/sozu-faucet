{
  "name": "sozu-faucet",
  "version": "0.1.0",
  "private": true,
  "description": "Sozu Faucet — Friendbot-like one-click Circle USDC SAC on Stellar testnet",
  "scripts": {
    "dev": "next dev --port 3010",
    "build": "next build",
    "start": "next start --port 3010",
    "lint": "eslint .",
    "db:migrate": "node --import tsx scripts/migrate.ts",
